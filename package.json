{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsc --project tsconfig.server.json",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "start": "node dist-server/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:server": "tsc --project tsconfig.server.json --pretty false",
    "typecheck": "npm run lint && npm run typecheck:server && npm run typecheck:strict",
    "db:fill-translations": "node scripts/fill-translations.cjs",
    "db:update-slug": "node scripts/update-slug.cjs",
    "typecheck:strict": "tsc --project tsconfig.strict.json --pretty false"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-image-crop": "^11.1.2",
    "react-router-dom": "^7.13.1",
    "sharp": "^0.35.3",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "supertest": "^7.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  }
}
